# Provenance for the six vendored extended-precision headers.
# Refresh via: cp from kokkos-extended-precision-demo@<sha>:third_party/include/

source_repo:   https://github.com/ReetBarik/kokkos-extended-precision-demo
source_branch: main
source_sha:    5ae2f800162ef4486c121e21301ff0e81615a45c
source_date:   2026-08-09 20:26:05 -0500
files:
  - dd_math.hpp
  - dd_complex.hpp
  - ff_math.hpp
  - ff_complex.hpp

# ------------------------------------------------------------
# QF (quad-float, 4xFP32) — vendored later than the dd/ff set, so it carries
# its own sha. QF is a DIFFERENT LINEAGE: ported from QD 2.3.24 (LBNL), not
# from DDFUN like dd/ff, and the files declare LicenseRef-LBNL-BSD-License
# rather than LicenseRef-DHB-License. License/NOTICE bookkeeping for that
# split is deliberately deferred (QF-integration task non-goal), so this repo
# vendors the headers without the LICENSES/ text they reference.
# ------------------------------------------------------------
qf_source_sha:  e67d7da192215585e439db77fd8627d086b56d36
qf_source_date: 2026-08-09 16:59:02 +0000   # last commit touching qf_math.hpp (6b6ee3e)
qf_files:
  - qf_math.hpp
  - qf_complex.hpp

# ------------------------------------------------------------
# PROVENANCE CAVEAT (recorded during the QF vendor, 2026-08-13).
#
# `source_sha` 5ae2f80 above NO LONGER RESOLVES in the upstream clone:
#     $ git -C ~/kokkos-extended-precision-demo cat-file -t 5ae2f80
#     fatal: git cat-file: could not get object info
# Upstream history was rewritten at some point after the dd/ff drop, so the
# recorded sha is now dangling. It is kept verbatim rather than silently
# rewritten to a live sha — it is what the dd/ff copy was actually taken from.
#
# The dd/ff CONTENT was re-verified against upstream HEAD (e67d7da) on the QF
# vendor: `diff -u <upstream-HEAD>/<file> third_party/include/<file>` yields
# exactly the local_patches set below and nothing else, so the vendored dd/ff
# are content-consistent with upstream HEAD despite the dangling sha. Only the
# two QF files were copied in this change; dd/ff were NOT re-vendored.
# ------------------------------------------------------------

# ============================================================
# LOCAL DELTA — the vendored files are NOT byte-identical to upstream.
#
# Upstream carries none of the patches below. They were re-applied on top of
# the verbatim copy and each is marked in-file as:
#     // LOCAL PATCH (<sha>): <rationale> — not upstream
# Run `git show <sha>` for the original commit. On the next refresh, re-apply
# every entry here against the newer upstream tip, or record why it was dropped.
#
# Note the entries are NOT independent: the scalar-comparison overloads exist
# to disambiguate the operator int() conversions. Re-applying one without the
# other reintroduces the `dd == 0` / `ff == 0` ambiguity. Treat as one unit.
# ============================================================
local_patches:
  - sha:   44c1ec4
    file:  dd_math.hpp, dd_complex.hpp
    what:  unary operator+(), operator int(), 6 scalar-double comparisons on the
           DoubleDouble scalar; unary operator+() on DoubleDoubleComplex too
           (no FloatFloatComplex twin — the pre-refresh surface had none either)
    why:   template-arg promotion rewrites double exprs to DoubleDouble in place;
           int-context and unary-plus uses must survive (B3m/B4m int<->Tracked).
           Upstream REMOVED operator int() in the Kokkos::Experimental rename —
           it was present in the original vendor drop.

  - sha:   3ab4aa6
    file:  ff_math.hpp
    what:  unary operator+()
    why:   FloatFloat mirror of the DoubleDouble patch above.

  - sha:   4f21245
    file:  ff_math.hpp
    what:  explicit FloatFloat(int) ctor
    why:   int -> FloatFloat is ambiguous between the float and double ctors.
           Routes via double so ints past float's 2^24 range don't truncate.
           DoubleDouble needs no equivalent (single floating ctor).

  - sha:   45197be
    file:  ff_math.hpp, dd_complex.hpp, ff_complex.hpp
    what:  FloatFloat operator int(); hypot-style overflow-safe complex abs()
           in BOTH complex headers, plus complex sqrt() reusing that abs
    why:   naive sqrt(re^2+im^2) overflows at sqrt(FLT_MAX) ~ 1.84e19, which was
           ff = nan on ~half of BIN inputs (STOP #HHH / #III). Applied to dd too
           for symmetry (same bug class, latent at ~1.34e154).
    NOTE:  dd_complex::abs is LOAD-BEARING FOR THE DD ORACLE — it is the oracle's
           magnitude, and the routing baseline is measured against this
           hypot-aligned form. Reverting to upstream's naive form shifts oracle
           values at the noise floor and reintroduces the analytic-zero metric
           artifact. Do not drop on refresh without re-baselining routing.

  - sha:   f12d8bf
    file:  ff_math.hpp
    what:  6 scalar-float comparison overloads
    why:   pairs with 45197be's operator int() — resolves the `ff == 0`
           ambiguity. Cleared the B4m.h comparison ambiguity.

# ============================================================
# QF LOCAL DELTA — qf_math.hpp only; qf_complex.hpp is byte-identical to upstream.
#
# A standalone TU including both QF headers compiles clean at -std=c++20 with NO
# patch. The four below were driven by the REAL per-group flip-TU compile
# (runs/qcdloop/qf_flip_probe.py), each traceable to a named source site, and
# each a twin of an existing dd/ff patch above.
# ============================================================
qf_local_patches:
  - sha:   QF integration 2026-08-13
    file:  qf_math.hpp
    what:  unary operator+() on QuadFloat
    why:   twin of dd 44c1ec4 / ff 3ab4aa6. Template-arg promotion rewrites double
           exprs to QuadFloat in place, so a source-level `+x` must survive.
    where: B2m.h `TOutput(+p3sq + m3sq - m4sq)` — "no match for operator+
           (operand type is const QuadFloat)".

  - sha:   QF integration 2026-08-13
    file:  qf_math.hpp
    what:  QuadFloat(int) ctor (NOT explicit — see the comparison note)
    why:   twin of ff 4f21245. int -> QuadFloat is ambiguous between the float and
           double ctors. Delegates to the double ctor so ints past float's 2^24
           exact range do not truncate.
    where: B3m.h / B4m.h `ql::Imag(r13) == 0` — "conversion from int to QuadFloat
           is ambiguous".

  - sha:   QF integration 2026-08-13
    file:  qf_math.hpp
    what:  operator int() on QuadFloat
    why:   twin of dd 44c1ec4 / ff 45197be. Routes via the FOUR-limb sum, not f0
           alone, so the low words still contribute near an exact-int boundary.
    where: B3m.h `ir14 = <QuadFloat expr>` where ir14 is int — "cannot convert
           QuadFloat to int in assignment".

  - sha:   QF integration 2026-08-13
    file:  qf_math.hpp
    what:  6 scalar-FLOAT comparison overloads
    why:   twin of dd 44c1ec4 / ff f12d8bf, and PAIRED with operator int() above —
           do not re-apply one without the other. Pristine QF resolves `qf == 0.0`
           via the implicit QuadFloat(double) ctor and needs no overloads; adding
           operator int() is what creates the ambiguity (both directions become
           user-defined conversions). These overloads take the literal by a
           standard floating-integral conversion, which outranks both.
           float and NOT double overloads: QuadFloat has BOTH converting ctors, so
           declaring both families would reintroduce the ambiguity. (dd uses double
           overloads because DoubleDouble has a single floating ctor.)

# DELIBERATELY NOT APPLIED (no call site demanded them; do not add pre-emptively):
#   * unary operator+() on QuadFloatComplex — dd has this twin, ff does not, and no
#     complex unary-plus site appeared in the QF flip TUs.
#   * hypot-style overflow-safe complex abs() + sqrt (dd/ff 45197be).
#     ** LATENT, NOT ABSENT. ** qf_complex.hpp ships the NAIVE sqrt(re^2+im^2),
#     which overflows at sqrt(FLT_MAX) ~ 1.84e19 — the identical FP32 ceiling that
#     produced ff = nan on ~half the BIN inputs (STOP #HHH / #III). It has not
#     fired because the two qf-routed integrals (B12, B16) are range-safe and the
#     range-unsafe BIN integrals never reach the qf rung (the fp32-family range
#     guard skips it). IF A RANGE-UNSAFE INTEGRAL IS EVER ROUTED TO qf, APPLY THE
#     HYPOT TWIN FIRST. Unlike dd_complex::abs this one is NOT load-bearing for the
#     oracle — the oracle is dd — so it can be added without re-baselining routing.

# Authoritative delta vs pristine upstream, measured with the temporary compat
# shim removed, i.e. this is exactly the persistent local patch set:
#
#   diff -u <upstream>/<file> third_party/include/<file>
#
# The 2 deleted lines in each complex header are the naive sqrt(re^2+im^2) abs
# body and the inlined magnitude inside complex sqrt(), both replaced by the
# hypot form (45197be). Everything else is pure addition, so a future refresh
# can re-apply the set by adding the marked blocks back.
#
# Counts re-measured against upstream HEAD on the QF vendor (2026-08-13); the
# dd_complex.hpp figure was stale (recorded +32, actual +40 — comment lines
# added to the patch blocks after the diffstat was first written).
local_delta_lines:
  dd_math.hpp:     +21  -0
  dd_complex.hpp:  +40  -2
  ff_math.hpp:     +27  -0
  ff_complex.hpp:  +28  -2
  qf_math.hpp:     +46  -0
  qf_complex.hpp:  +0   -0

# Locate every re-applied block in a refreshed file with:
#   grep -n 'LOCAL PATCH' third_party/include/*.hpp
