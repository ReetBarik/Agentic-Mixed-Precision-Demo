# Build artifacts
build/

# Journals (100k+ runs regenerate locally from the committed driver + shim +
# patch); keep the journal, its compressed snapshots, any Parquet exports, and
# run.log out of git. Mirrors runs/B13/.gitignore.
journal.jsonl
journal*.jsonl.gz
*.parquet
run.log
run_chunked*.log

# journal_meta.json is a small build/run metadata sibling; regenerated on every
# run alongside the journal, so it is also kept out of git.
journal_meta.json

# Chunked-runner transient shards and consolidated reports (run_chunked.py):
# regenerated locally from the committed driver + shim + patches.
shards/
report_*.json
report_*.json.gz
