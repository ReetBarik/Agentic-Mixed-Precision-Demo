# Local Kokkos clone (installed out-of-tree; sourced via scripts/prepare.sh)
kokkos/

# Build artifacts and logs (regenerated locally)
build/
build_logs/

# Generated agent outputs (per-target, ephemeral verification artifacts)
experiments/*/generated/

# Validator run artifacts (baseline caches + persisted precise-digits arrays)
runs/qcdloop/validator/cache/
runs/qcdloop/validator/*/
!runs/qcdloop/validator/.gitkeep

# Strategy run artifacts (per-run report + iteration log + cumulative diff)
runs/qcdloop/strategy/*/
!runs/qcdloop/strategy/.gitkeep

# Per-integral orchestrator run artifacts (filtered reports + cloned trees + manifests)
runs/qcdloop/per_integral_out/

# Python caches
**/__pycache__/
*.py[cod]

# Local virtual environments
.venv/
venv/
